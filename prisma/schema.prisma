generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Zone {
  id          Int          @id @default(autoincrement())
  nom         String
  producteurs Producteur[]
}

model Producteur {
  id          Int       @id @default(autoincrement())
  nom         String
  description String?
  zoneId      Int
  zone        Zone      @relation(fields: [zoneId], references: [id])
  produits    Produit[]
}


model Produit {
  id           Int        @id @default(autoincrement())
  nom          String
  description  String?
  type         String
  lienBoutique String?
  producteurId Int
  producteur   Producteur @relation(fields: [producteurId], references: [id])
}