generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Continent {
  id          Int          @id @default(autoincrement())
  nom         String
  pays        Pays[]
}

model Pays {
  id          Int          @id @default(autoincrement())
  nom         String
  continentId Int
  continent   Continent    @relation(fields: [continentId], references: [id])
  regions     Region[]
}

model Region {
  id          Int          @id @default(autoincrement())
  nom         String
  paysId      Int
  pays        Pays         @relation(fields: [paysId], references: [id])
  producteurs Producteur[]
}

model Producteur {
  id          Int       @id @default(autoincrement())
  nom         String
  description String?
  logoUrl     String?
  regionId    Int
  region      Region      @relation(fields: [regionId], references: [id])
  produits    Produit[]
}


model Produit {
  id           Int        @id @default(autoincrement())
  nom          String
  description  String?
  type         String
  imageUrl     String?
  lienBoutique String?
  producteurId Int
  producteur   Producteur @relation(fields: [producteurId], references: [id])
}