generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Parcours admin : Login & DashBoard
model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

// Parcours utilisateur : Navigation par zone
model Produit {
  id         Int    @id @default(autoincrement())
  nom        String
  producteur String
  zone       String
}